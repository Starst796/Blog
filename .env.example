# ============================================================================
# 环境变量模板
#
# 用法：cp .env.example .env  （.env 已被 .gitignore 排除，不会进入仓库）
# 所有变量都可以留空或不写：没有配置时程序按 config.py 中的默认值运行。
# ============================================================================

# ---------- 站点 ----------
# 对外访问地址，用于 canonical 链接、sitemap.xml 与 atom.xml。
# 默认值是本地开发用的 http://127.0.0.1:8080，上线前务必改成真实域名。
# SITE_URL=https://example.com

# 页面语言与 Atom 时区偏移（按站点作者所在地设置即可）
SITE_LANG=zh-CN
SITE_TZ_OFFSET=+08:00

# ---------- 内容目录 ----------
# 不设置则使用仓库内的 content/，clone 下来即可运行。
# 生产环境建议指向部署目录之外，避免部署时被 git checkout 覆盖：
# CONTENT_DIR=/srv/blog/content

# ---------- 监听 ----------
# 一般保持 127.0.0.1，由 nginx 反向代理对外提供服务
HOST=127.0.0.1
PORT=8080
# 本地调试可设为 1 开启自动重载，生产必须为 0
FLASK_DEBUG=0

# ---------- 会话 ----------
# 生产走 https 必须为 1；本地用 http 调试时改成 0，否则浏览器不回传会话 cookie
SESSION_COOKIE_SECURE=0

# ---------- 列表分页 ----------
PAGE_SIZE=10
HOMEPAGE_LIMIT=3

# ---------- 登录限流 ----------
LOGIN_ATTEMPT_IP_LIMIT=8
LOGIN_ATTEMPT_IP_WINDOW=300

# ---------- 机密（请勿手工填写）----------
# 下面三项由 manage.py 生成并写入 .env，留空即可：
#   python manage.py init          生成 SECRET_KEY 与 ADMIN_USERNAME
#   python manage.py set-password  交互式设置密码，仅保存哈希
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
